# Copy to .env.local and adjust.

# --- Database ---------------------------------------------------------------
# Local Postgres from docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://schoolcircle:schoolcircle@localhost:5433/schoolcircle?schema=public"
#
# Edge / offline (a Jetson at a schoolhouse): set provider = "sqlite" in
# prisma/schema.prisma, then point DATABASE_URL at a file. Nothing else changes.
# DATABASE_URL="file:./schoolcircle.db"

# --- Grounding (Anchor) -----------------------------------------------------
# The grounding engine over the USB/SSH tunnel. Unset = grounding off (the app
# still runs; the tutor refuses instead of answering ungrounded).
DOCTRINE_BASE_URL="http://localhost:8000"
DOCTRINE_TIMEOUT_MS="30000"
