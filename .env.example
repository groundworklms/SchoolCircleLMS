# Copy to .env.local and adjust.

# --- Database ---
# Local dev (docker compose up -d):
DATABASE_URL="postgresql://schoolcircle:schoolcircle@localhost:5432/schoolcircle_dev?schema=public&connection_limit=5&pool_timeout=10"
SCHOOLCIRCLE_DB_ENV="development"
# Explicit database-name confirmation required for db:deploy / db:migrate.
DATABASE_TARGET_CONFIRM="schoolcircle_dev"
# Seed stays disabled unless you explicitly opt in on an isolated demo database.
ALLOW_DEMO_SEED="false"
#
# Offline / edge: use local PostgreSQL with the SAME provider/schema (leave the
# CLOUD_SQL_* vars unset).
# Cloud (App Hosting): DATABASE_URL is a runtime secret (user/password/database; host is
# ignored) and the app connects through the Cloud SQL connector:
# CLOUD_SQL_CONNECTION_NAME="schoolcircle-ae29a:us-east4:schoolcircle-ae29a-instance"
# To migrate/seed the cloud DB from a laptop: `npm run db:proxy` then point DATABASE_URL
# at 127.0.0.1:5433. Never put cloud credentials here. See docs/CLOUD_POSTGRES.md.
#
# Enterprise (Track B) -- a managed Postgres in the approved enclave.

# --- Grounding engine (Anchor) ---
# The offline doctrine tutor. Unset = ungrounded fallback; set it to a running Anchor.
# DOCTRINE_BASE_URL="http://127.0.0.1:8000"
# DOCTRINE_TIMEOUT_MS="30000"

# --- Text model (generation) ---
# Any OpenAI-compatible endpoint: a served open-weight LLM (the on-device gen model,
# vLLM, Ollama, TGI, ...). Self-hosted is the default; no cloud fallback is inferred.
# Unset = generation features report 503 NO_PROVIDER (no mock or cloud fallback).
# BOTH MODEL_BASE_URL and MODEL_ID are required for the text capability to be ready.
# MODEL_BASE_URL="http://127.0.0.1:8001/v1"
# MODEL_ID="(your served model id)"
# MODEL_API_KEY=""   # only if your endpoint requires one
#
# Authorized development/testing only: OpenRouter is opt-in and requires this
# exact base URL plus the existing runtime secret. A key alone never selects it.
# The model is explicit rather than an alias; verify the public catalog before
# changing it. Do not enable this overlay for production/offline deployments.
# MODEL_BASE_URL="https://openrouter.ai/api/v1"
# MODEL_ID="google/gemini-3.1-pro-preview"
# OPENROUTER_API_KEY=""   # runtime secret; never commit or log its value

# --- Firebase Authentication (login) ---
# All PUBLIC client config (safe in the browser) -- from the Firebase console
# (Project settings -> Your apps -> Web app). Set these in Firebase App Hosting.
# If left unset, login is disabled and the app stays fully open (no lockout).
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Learning API (/api/learning, the Learn / Teach apps) ---
# Server-side identity: Firebase ID tokens are verified with the PUBLIC project id
# above (NEXT_PUBLIC_FIREBASE_PROJECT_ID). No service account is needed. Without
# it, /api/learning/* answers 401 and everything else stays open as before.
#
# Rubricon (rubric generation) and Whetstone (mastery sessions) call their own
# isolated OpenAI-compatible endpoints. Unset = those routes answer 503. For
# authorized OpenRouter development/testing, set each endpoint explicitly to
# the chat-completions URL and leave its dedicated key unset to use the existing
# OPENROUTER_API_KEY. A shared key is never accepted for another endpoint.
# RUBRICON_ENDPOINT="https://openrouter.ai/api/v1/chat/completions"
# RUBRICON_MODEL="google/gemini-3.1-pro-preview"
# RUBRICON_API_KEY=""
# WHETSTONE_ENDPOINT="https://openrouter.ai/api/v1/chat/completions"
# WHETSTONE_MODEL="google/gemini-3.1-pro-preview"
# WHETSTONE_API_KEY=""
#
# Run the Postgres-backed learning tests (npm test) against DATABASE_URL:
# RUN_DB_TESTS=1
#
# Tester allowlist: only these emails may sign in or create an account
# (comma-separated, case-insensitive). Unset = allowlist off (anyone with a
# Firebase account gets in).
# NEXT_PUBLIC_ALLOWED_EMAILS="you@example.com,teammate@example.com"
