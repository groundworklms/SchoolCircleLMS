// Data model for the grounded LMS.
//
// PostgreSQL for both cloud and offline/edge. Use Cloud SQL in the cloud and local
// PostgreSQL on the hardware; keep this provider/schema and change DATABASE_URL.
// The two databases have independent data; switching URLs does not synchronize them.
//
// One boundary is deliberate and lives HERE, not in the UI: there is no ClassGap table. The
// instructor's aggregate view is a GROUP BY over Attempt that never SELECTs learnerId (see
// docs/DATA_MODEL.md). Keeping it a query, not a table, means an instructor cannot be handed
// one Marine's answers by construction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  INSTRUCTOR
  LEARNER
  BOTH
}

enum ItemKind {
  LESSON        // a cited teaching claim
  QUESTION      // an assessment item
  SCENARIO      // a branching applied problem
}

enum ItemStatus {
  PENDING       // generated by Anchor, awaiting instructor review
  APPROVED      // human-in-the-loop guardrail: nothing unseen reaches a student
  REJECTED
}

model User {
  id        String    @id @default(cuid())
  name      String
  rank      String?   @db.VarChar(40)
  branch    String?
  payGrade  String?
  profileCompletedAt DateTime?
  role      Role      @default(LEARNER)
  // For MarineNet/LTI later: the LTI `sub` claim maps here, so local accounts and SSO
  // identities share one table without a schema change.
  externalId String?  @unique
  attempts  Attempt[]
  mastery   Mastery[]
  schedules Schedule[]
  createdAt DateTime  @default(now())
}

model Course {
  id        String    @id @default(cuid())
  title     String
  sourceId  String                       // Anchor corpus id, e.g. "TC 3-22.9"
  sections  Section[]
  createdAt DateTime  @default(now())
}

model Section {
  id       String  @id @default(cuid())
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  title    String
  order    Int     @default(0)
  items    Item[]

  @@index([courseId])
}

model Item {
  id        String     @id @default(cuid())
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String
  kind      ItemKind
  stem      String                        // the claim / question stem / scenario prompt
  options   Json?                         // MC options, when kind = QUESTION
  answer    Json?                         // keyed answer
  rationale String?
  // Paragraph-level citation from Anchor: { citation, pubId, section, para, page }.
  citation  Json?
  support   Float?                        // HHEM support score for the keyed answer
  status    ItemStatus @default(PENDING)  // human ratifies before a student sees it
  attempts  Attempt[]
  schedules Schedule[]
  createdAt DateTime   @default(now())

  @@index([sectionId, status])
}

model Attempt {
  id         String   @id @default(cuid())
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     String
  learner    User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId  String
  // Stated BEFORE the reveal (0=guessing .. 3=certain). With `correct`, this is the
  // calibration signal -- the confidently-wrong learner a normal quiz hides.
  confidence Int
  answer     Json
  correct    Boolean
  gradedAgainst Json?                      // the citation the answer was graded against
  createdAt  DateTime @default(now())

  @@index([learnerId, itemId])
  @@index([itemId])                        // supports the aggregate class view (no learnerId)
}

model Mastery {
  id             String   @id @default(cuid())
  learner        User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId      String
  section        String
  masteryPct     Float    @default(0)
  calibrationGap Float?
  updatedAt      DateTime @updatedAt

  @@unique([learnerId, section])
}

model Schedule {
  id        String   @id @default(cuid())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  learner   User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId String
  dueAt     DateTime
  interval  Int      @default(1)           // days; set by confidence-weighted spacing
  createdAt DateTime @default(now())

  @@unique([itemId, learnerId])
  @@index([learnerId, dueAt])
}

// Additive boundary for integrations that do not have a first-class LMS table yet.
// The payload is always JSON produced by a reviewed adapter (source, draft, rubric,
// tutor turn, or mastery session). `ownerId` is the authenticated SchoolCircle User
// id; no client-provided identity is accepted by the learning routes.
model LearningRecord {
  id        String   @id @default(cuid())
  ownerId   String
  type      String
  status    String   @default("PENDING")
  payload   Json
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, type])
  @@index([type, status])
}
