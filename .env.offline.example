# SchoolCircle OFFLINE run — laptop against a Jetson Orin (Anchor), network pulled.
# Copy to .env.offline, fill the placeholders, then run scripts/offline/start-offline.mjs.
# See docs/offline-runbook.md. Do NOT use these values on the hosted deployment.

# --- Database (LOCAL Postgres via docker-compose.yml — same provider as prod) ---
# Points at the container in docker-compose.yml (postgres:16, 127.0.0.1:5432). No schema change.
DATABASE_URL="postgresql://schoolcircle:schoolcircle@127.0.0.1:5432/schoolcircle_dev?schema=public&connection_limit=5&pool_timeout=10"
# These two gate `npm run db:deploy`/`db:seed` so migrations can never hit a cloud DB by accident.
SCHOOLCIRCLE_DB_ENV="development"           # must be development|demo|test|production; use development here
DATABASE_TARGET_CONFIRM="schoolcircle_dev"  # must equal the DB name in DATABASE_URL above
ALLOW_DEMO_SEED="false"                      # set true ONLY to opt into the demo seed on this local DB

# --- Grounding engine (Anchor on the Orin, USB device-mode) ---
DOCTRINE_BASE_URL="http://192.168.55.1:8000" # the board; /api/ask, /api/health, /api/corpus, /api/ground
DOCTRINE_TIMEOUT_MS="30000"                  # optional; per grounded answer

# --- Local operator sign-in (REQUIRED for offline auth; see docs/offline-operator-auth.md) ---
AUTH_MODE="offline"                          # exact string "offline"; server gate for the offline seam
OFFLINE_AUTH_SECRET=""                       # >=32 chars signing key; `openssl rand -base64 48`. NEVER commit.
OFFLINE_AUTH_REALM="local"                   # namespaces User.externalId (offline:<realm>:<subject>); default "local"
OFFLINE_AUTH_SESSION_HOURS="12"              # session lifetime, hours, clamped 1-168 (Firebase's 1h refresh can't run offline)
# JSON array minted by scripts/offline/operator-passphrase.mjs (scrypt salt+hash only, never a plaintext passphrase):
#   printf '%s' 'the passphrase' | node scripts/offline/operator-passphrase.mjs sgt-okafor INSTRUCTOR 'SSgt Okafor'
OFFLINE_AUTH_OPERATORS='[]'                  # e.g. [{"subject":"sgt-okafor","name":"SSgt Okafor","role":"INSTRUCTOR","passphrase":{"alg":"scrypt","salt":"...","hash":"...","N":16384,"r":8,"p":1,"keylen":32}}]
NEXT_PUBLIC_AUTH_MODE="offline"              # public build flag that RENDERS the offline sign-in form; grants nothing alone

# --- Firebase Authentication — LEAVE UNSET when offline ---
# With no NEXT_PUBLIC_FIREBASE_* set, hosted login is disabled and the app stays open;
# the offline operator credential above is the sign-in path. Do not set these for a pulled-cable demo.
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# --- Optional: on-device generation / student-chat fallback (Level 2, not needed for the tutor demo) ---
# Only if the app should also GENERATE drafts on the board; requires tutor-gen bound to the USB iface.
# MODEL_BASE_URL="http://192.168.55.1:8080/v1"
# MODEL_ID="(exact id from http://192.168.55.1:8080/v1/models)"
# STUDENT_LOCAL_BASE_URL="http://192.168.55.1:8080/v1"
# STUDENT_LOCAL_MODEL_ID="(exact served model id)"
