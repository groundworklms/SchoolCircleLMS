modules = ["nodejs-24"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SchoolCircle Next.js"

[[workflows.workflow]]
name = "SchoolCircle Next.js"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx next dev --hostname 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
