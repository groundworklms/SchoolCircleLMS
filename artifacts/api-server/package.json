    "sourcerer": "github:groundworklms/sourcerer#8a2e6831ebc6ced8ee71b0215fb0037d1cb7c1bb",
    "understudy": "github:groundworklms/understudy#6ecb931b85af9cf36aab185f587dd3ede4a61d96",
    "waypoint": "github:groundworklms/waypoint#a861421b03399b8dc39f06aad113d1f064f465e4",
