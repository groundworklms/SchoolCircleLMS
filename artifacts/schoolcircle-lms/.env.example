# Firebase browser configuration. Leave these unset for the no-lockout demo mode:
# /prototype stays publicly accessible and /login shows its continue action.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# VITE_PUBLIC_FIREBASE_* aliases are also supported for deployment compatibility.