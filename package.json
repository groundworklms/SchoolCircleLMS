{
  "name": "schoolcircle-lms",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "pnpm run db:generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test:api": "pnpm --filter @workspace/api-server run test",
    "test:next": "node --experimental-test-module-mocks --test tests/*.test.mjs",
    "test:doctrine-auth": "node --experimental-test-module-mocks --test tests/doctrine-auth.test.mjs",
    "test": "pnpm run test:next && pnpm run test:api",
    "api:test": "pnpm run test:api",
    "db:generate": "prisma generate --schema ./prisma/schema.prisma",
    "db:seed": "node scripts/database.mjs seed",
    "db:studio": "prisma studio --schema ./prisma/schema.prisma",
    "postinstall": "prisma generate",
    "test:upstream-learning": "node --test test/auth.test.mjs test/learning-core.test.mjs test/learning-evidence.test.mjs test/learning-handlers.test.mjs test/learning-persistence.test.mjs",
    "db:migrate": "node scripts/database.mjs develop",
    "db:deploy": "node scripts/database.mjs deploy",
    "db:status": "node scripts/database.mjs status",
    "test:db-policy": "node --test tests/database-seed*.mjs",
    "test:db": "node tests/postgres-integration.mjs",
    "db:proxy": "node scripts/cloud-sql-proxy.mjs"
  },
  "private": true,
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.3.0",
    "@replit/connectors-sdk": "^0.4.3",
    "@tanstack/react-query": "^5.90.21",
    "cadence": "github:groundworklms/cadence#9b6b2df0ab1e11080510262a631ffb7e13acda4e",
    "cartridge": "github:groundworklms/cartridge#68f02aa93bca51c4d24f42b8392a4f5ad02c8db3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "coursewright": "github:groundworklms/coursewright#f38d078a30195a6a6901ade22a3ce7484613fa57",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "hotwash": "github:groundworklms/hotwash#a972df65aa1c45c6b28c7fd6540a3b9303cf7b74",
    "lucide-react": "^0.545.0",
    "multer": "^2.0.2",
    "next": "15.5.25",
    "openid-client": "^6.8.8",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "quarry": "github:groundworklms/quarry#465b7515732bbc08b80b6ec8684e1fc49c7985ea",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "9.0.3",
    "remark-gfm": "4.0.0",
    "rubricon": "github:groundworklms/rubricon#1a3d88c9cef6e0239da060e936398fa6b999c6a9",
    "sextant": "github:groundworklms/sextant#007a2c0f47fd50a9acbc3f3538814c1bf8683e95",
    "sourcerer": "github:groundworklms/sourcerer#8a2e6831ebc6ced8ee71b0215fb0037d1cb7c1bb",
    "tailwind-merge": "^3.3.1",
    "understudy": "github:groundworklms/understudy#6ecb931b85af9cf36aab185f587dd3ede4a61d96",
    "waypoint": "github:groundworklms/waypoint#a861421b03399b8dc39f06aad113d1f064f465e4",
    "whetstone": "github:groundworklms/whetstone#4b5d0a4be05a5a2161a4d46f9261ff88a43d8b2b",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.6",
    "prisma": "^6.3.0",
    "typescript": "~5.9.3"
  }
}
